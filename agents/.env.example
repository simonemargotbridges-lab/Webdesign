# ============================================================
# Simone Outreach Agents — environment variables
# Copy this file to `.env` and fill in your real keys.
# NEVER commit the real `.env` file.
# ============================================================

# --- Claude (Anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Places API (for finding prospects) ---
# Enable "Places API (New)" in Google Cloud Console and create an API key.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default search area (used by findProspects.js if no CLI args)
SEARCH_LOCATION="Wellesley, MA"
SEARCH_RADIUS_METERS=5000
SEARCH_KEYWORDS="nail salon,bakery,plumber,barber,hair salon,dry cleaner,landscaper"

# --- Gmail (sending email via SMTP) ---
# Use a Google Account App Password, NOT your normal password.
# https://myaccount.google.com/apppasswords  (requires 2FA enabled)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Your business identity (appears in emails) ---
YOUR_NAME="Simone Bridges"
YOUR_BUSINESS="Simone Bridges Web Design"
YOUR_REPLY_EMAIL=you@gmail.com
YOUR_PHONE="(617) 555-0100"
YOUR_PORTFOLIO_URL="https://simonemargotbridges-lab.github.io/webdesign/"
YOUR_MAILING_ADDRESS="Wellesley, MA"

# --- Venmo (payment link included in the email signature) ---
VENMO_USERNAME=Simone-Bridges
VENMO_LINK=https://venmo.com/u/Simone-Bridges

# --- Safety switches ---
# When DRY_RUN=true, no emails are actually sent — they're just printed.
DRY_RUN=true
# Max emails to send per run (hard cap, to avoid looking like spam)
MAX_EMAILS_PER_RUN=5
