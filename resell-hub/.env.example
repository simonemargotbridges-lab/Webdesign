# Copy this file to .env and fill in what you have.
# The app works with none of these set — it just runs in local/simulated mode.

# ---- AI descriptions & pricing ----
# Optional. Without it, the app falls back to a built-in trendy-description
# template and a rule-based price estimator, so it still works out of the box.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- eBay (the only marketplace here with a real public listing API) ----
# Create a developer app at https://developer.ebay.com and complete the
# OAuth "user consent" flow to get a token that can create listings on your
# own account. Without this, the eBay connector runs in simulated mode.
EBAY_ENV=sandbox
EBAY_OAUTH_TOKEN=
EBAY_MERCHANT_LOCATION_KEY=

# ---- Server ----
PORT=3000
